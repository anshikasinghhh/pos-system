# Environment Variables for SmartPOS Backend
# Copy this to .env file and fill in your values

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=2

# Database (use your Atlas URI as MONGODB_URI in production)
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=smartpos

# Server
PORT=8000
DEBUG=True

# CORS
ALLOWED_ORIGINS=https://pos-system1-xivr.onrender.com,http://localhost:5173,http://localhost:3000
